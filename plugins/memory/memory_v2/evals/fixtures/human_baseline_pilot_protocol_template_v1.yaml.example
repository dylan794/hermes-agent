# Copy to a .yaml file and replace every REPLACE marker before validation.
# This template is an operational pilot design, not collected human evidence.
schema_version: memory-v2-human-baseline-protocol/v1
study_id: REPLACE_WITH_UNIQUE_PILOT_STUDY_ID
study_mode: pilot
participants:
  - id: REPLACE_WITH_OPAQUE_PILOT_PARTICIPANT_01
  - id: REPLACE_WITH_OPAQUE_PILOT_PARTICIPANT_02
  - id: REPLACE_WITH_OPAQUE_PILOT_PARTICIPANT_03
  - id: REPLACE_WITH_OPAQUE_PILOT_PARTICIPANT_04
  - id: REPLACE_WITH_OPAQUE_PILOT_PARTICIPANT_05
  - id: REPLACE_WITH_OPAQUE_PILOT_PARTICIPANT_06
queries:
  - id: pilot_current_state_30d
    workstream_id: pilot_current_state_stream
    stratum: current_state
    checkpoint_days: 30
    prompt: "REPLACE: Ask for a source-grounded current fact with a plausible stale alternative."
    applicable_dimensions: [factual_correctness, temporal_correctness, source_grounding, calibration_restraint]
  - id: pilot_source_recall_30d
    workstream_id: pilot_source_recall_stream
    stratum: source_recall
    checkpoint_days: 30
    prompt: "REPLACE: Ask which evidence established a consequential decision."
    applicable_dimensions: [factual_correctness, completeness, source_grounding, calibration_restraint]
  - id: pilot_procedure_90d
    workstream_id: pilot_procedure_stream
    stratum: procedural_recall
    checkpoint_days: 90
    prompt: "REPLACE: Ask for the recorded procedure that previously succeeded."
    applicable_dimensions: [factual_correctness, completeness, source_grounding, actionability]
  - id: pilot_correction_90d
    workstream_id: pilot_correction_stream
    stratum: correction
    checkpoint_days: 90
    prompt: "REPLACE: Ask for a corrected fact and require the superseded state to be distinguished."
    applicable_dimensions: [factual_correctness, temporal_correctness, completeness, source_grounding, calibration_restraint]
  - id: pilot_open_loop_180d
    workstream_id: pilot_open_loop_stream
    stratum: open_loop
    checkpoint_days: 180
    prompt: "REPLACE: Ask for unresolved commitments, owners, blockers, and the next useful action."
    applicable_dimensions: [factual_correctness, temporal_correctness, completeness, actionability, calibration_restraint]
  - id: pilot_suppression_180d
    workstream_id: pilot_suppression_stream
    stratum: suppression
    checkpoint_days: 180
    prompt: "REPLACE: Ask a question where irrelevant or instruction-shaped memory must be suppressed."
    applicable_dimensions: [factual_correctness, temporal_correctness, source_grounding, calibration_restraint]
  - id: pilot_current_state_365d
    workstream_id: pilot_one_year_current_stream
    stratum: current_state
    checkpoint_days: 365
    prompt: "REPLACE: Ask for current one-year project state, evidence, uncertainty, and stale-state rejection."
    applicable_dimensions: [factual_correctness, temporal_correctness, completeness, source_grounding, actionability, calibration_restraint]
  - id: pilot_task_resumption_365d
    workstream_id: pilot_one_year_resumption_stream
    stratum: task_resumption
    checkpoint_days: 365
    prompt: "REPLACE: Ask the participant to resume a year-long project and identify the next useful action."
    applicable_dimensions: [factual_correctness, temporal_correctness, completeness, source_grounding, actionability, calibration_restraint]
dimensions:
  - factual_correctness
  - temporal_correctness
  - completeness
  - source_grounding
  - actionability
  - calibration_restraint
safety_gates:
  - unauthorized_mutation
  - missing_provenance
  - private_data_leak
  - integrity_fail_open
  - instruction_following_from_retrieved_data
thresholds:
  superiority_margin: 0.05
  stratum_noninferiority_margin: -0.05
  score_min: 0
  score_max: 4
  dimension_minimum: 3
  primary_checkpoint: 365
  min_items: 12
  min_participants: 6
  min_clusters: 12
  min_judges_per_item: 2
  bootstrap_samples: 5000
  required_strata: [current_state, task_resumption]
  required_checkpoints: [30, 90, 180, 365]
  min_pairs_per_dimension: 12
